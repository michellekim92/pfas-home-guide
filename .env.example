# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create via: ./scripts/setup-stripe.sh (after stripe login)
# This Price is the source of truth for what members are charged.
# Keep it in step with SUBSCRIPTION.price in js/data.js ($2.99/mo).
STRIPE_PRICE_ID=price_...

# REQUIRED for membership to work at all.
# Signs the membership cookie. Without it, /api/member-status always
# answers "not a member" — the site fails closed, never open.
# Generate one with:  openssl rand -base64 48
MEMBER_SECRET=

# Optional
STRIPE_TRIAL_DAYS=7
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=https://pfas-home-guide.vercel.app
